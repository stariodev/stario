from collections.abc import Iterable, Mapping
from typing import Any, Final, Literal, final, overload

from stario.markup.types import (
    AttributeValue,
    ClassInput,
    HtmlElement,
    TagAttributes,
)

type EmptyMode = Literal["normal", "void", "self_closing_when_empty"]

def escape_text(s: str) -> str: ...
def escape_attribute_value(s: str) -> str: ...
def escape_sq_attribute_value(s: str) -> str: ...
def check_raw_text(text: str, tag: str) -> None: ...
def _valid_key_cache_size() -> int: ...

@final
class SafeString:
    """Markup inserted verbatim into rendered HTML (no escaping)."""

    __match_args__ = ("rendered",)
    @property
    def rendered(self) -> str: ...
    def __init__(self, rendered: str) -> None: ...

@final
class Attrs:
    """Trusted, pre-rendered opening-tag attributes, starting with a space."""

    __match_args__ = ("rendered",)
    @property
    def rendered(self) -> str: ...
    def __init__(self, rendered: str) -> None: ...

@final
class Element:
    """One built element. Immutable; only a `Tag` call makes one."""

    @property
    def tag(self) -> Tag: ...
    @property
    def name(self) -> str: ...
    @property
    def attrs(self) -> str | None: ...
    @property
    def children(self) -> tuple[HtmlElement, ...]: ...
    def __getitem__(self, key: str) -> str | Literal[True]: ...
    @overload
    def get(self, key: str) -> str | Literal[True] | None: ...
    @overload
    def get[D](self, key: str, default: D) -> str | Literal[True] | D: ...
    def __contains__(self, key: object) -> bool: ...
    def with_attrs(self, *attributes: TagAttributes | None) -> Element: ...

class Tag:
    """Callable factory for a single HTML or SVG element name."""

    @property
    def name(self) -> str: ...
    @property
    def empty_mode(self) -> EmptyMode: ...
    @property
    def raw_text(self) -> bool: ...
    @property
    def tag_start(self) -> str: ...
    @property
    def tag_start_no_attrs(self) -> str: ...
    @property
    def closing_tag(self) -> str: ...
    @property
    def no_children_close(self) -> str: ...
    @property
    def empty_html(self) -> str: ...
    @property
    def empty(self) -> Element: ...
    def __init__(
        self,
        name: str,
        *,
        empty: EmptyMode = "normal",
        prefix: str = "",
        raw_text: bool = False,
    ) -> None: ...
    def __call__(self, *children: TagAttributes | HtmlElement) -> Element: ...
    def _repr(self) -> str: ...

class VoidTag(Tag):
    """A void element factory (`br`, `img`, `input`, ...): attributes only."""

    def __init__(self, name: str, *, prefix: str = "") -> None: ...
    def __call__(self, *attributes: TagAttributes | None) -> Element: ...  # type: ignore[override]

classes_cache: Final[dict[tuple[Any, ...], Attrs]]
CLASSES_CACHE_MAX: Final[int]

def classes(*tokens: ClassInput) -> Attrs: ...
def prefixed(prefix: str, attrs: Mapping[str, AttributeValue]) -> Attrs: ...
def data(attrs: Mapping[str, AttributeValue]) -> Attrs: ...
def aria(attrs: Mapping[str, AttributeValue]) -> Attrs: ...
def element_parts(
    el: Element,
) -> tuple[str, str | list[Any] | None, tuple[HtmlElement, ...] | None, str]: ...
def splice_attribute(key: str, value: Any) -> str: ...
def splice_child(value: Any) -> str: ...
def shared_safe_string(rendered: str) -> SafeString: ...
def render_nodes_to_string(
    nodes: Iterable[Any], *, root_count: int | None = None
) -> str: ...
def render(*nodes: HtmlElement) -> str: ...
def render_bytes(*nodes: HtmlElement) -> bytes: ...
